# syntax=docker/dockerfile:1.7
#
# Hermes WebUI is the control plane for WebUI terminal calls. It needs only the
# Docker client so it can start Hermes' isolated hermes-dev terminal container.
# Development tooling remains exclusively in hermes-dev.

FROM docker:29.7.2-cli AS docker-cli

FROM ghcr.io/nesquena/hermes-webui

USER root

# Docker's official CLI image provides the client binary. It connects to the
# host daemon through the socket mounted in docker-compose.yaml at runtime.
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

# Fail the image build clearly if the copied CLI is unavailable.
RUN docker --version