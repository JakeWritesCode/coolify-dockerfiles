# syntax=docker/dockerfile:1.7
#
# Reproducible terminal image for Hermes-driven local application development.
# This is deliberately a development/tooling image, not the gateway/WebUI image.
#
# Included:
# - Go 1.27
# - Node 22, npm, npx, Corepack (pnpm/Yarn)
# - Docker CLI, Buildx, Compose v2
# - golangci-lint
# - Git, Make, build tooling, Python, PostgreSQL client utilities

FROM node:22-bookworm-slim AS node

FROM golang:1.27.0-bookworm

ARG GOLANGCI_LINT_VERSION=v2.13.1

ENV DEBIAN_FRONTEND=noninteractive \
    GOPATH=/opt/go \
    GOBIN=/usr/local/bin \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    PATH=/opt/go/bin:/usr/local/go/bin:${PATH}

# General local-development tooling:
# - build-essential / Python: native Node modules and Go CGO dependencies
# - postgresql-client: database inspection and EXPLAIN diagnostics
# - Docker packages: host-daemon Docker CLI, Compose v2, and Buildx
RUN apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        curl \
        git \
        gnupg \
        jq \
        make \
        netcat-openbsd \
        openssh-client \
        postgresql-client \
        procps \
        python3 \
        python3-pip \
        python3-venv \
        ripgrep \
        tini \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL --retry 3 https://download.docker.com/linux/debian/gpg \
        | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && printf '%s\n' \
        "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        docker-buildx-plugin \
        docker-ce-cli \
        docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# Preserve Node's full official /usr/local layout, including Node, npm, npx,
# Corepack, and their package trees. Do not recreate Node symlinks manually.
COPY --from=node /usr/local /usr/local

# The WebUI terminal currently starts Bash with a conservative PATH that omits
# /usr/local/go/bin. Make Go's standard commands available via /usr/local/bin,
# which remains on that terminal PATH.
RUN ln -sf /usr/local/go/bin/* /usr/local/bin/

# Validate each foundational tool independently. Do not run gofmt against
# /dev/null: it requires actual Go source input.
RUN go version
RUN node --version
RUN npm --version
RUN npx --version
RUN corepack --version
RUN docker --version
RUN docker compose version
RUN docker buildx version

# Pin the linter so local checks and CI execute the same version.
RUN go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}
RUN golangci-lint --version

# Match the UID/GID that owns the shared host workspace.
RUN groupadd --gid 1000 dev \
    && useradd --uid 1000 --gid dev --create-home --shell /bin/bash dev \
    && install -d --owner=dev --group=dev /workspace /opt/go

USER 1000:1000

ENV HOME=/home/dev

WORKDIR /workspace

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]